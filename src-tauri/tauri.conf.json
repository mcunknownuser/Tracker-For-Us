{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VoltrisAi",
  "version": "0.1.1",
  "identifier": "com.voltrisai.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VoltrisAi",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJENDdGMTA4QjY1MzcwRDYKUldUV2NGTzJDUEZITFNZOG5tdW1oN0JnTnU5VENya3MwVjN1SUhVV1B4eHVLSDk1ZktMei9JMTAK",
      "endpoints": [
        "https://github.com/mcunknownuser/Tracker-For-Us/releases/latest/download/latest.json"
      ]
    }
  }
}